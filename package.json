{
  "name": "midnight-mafia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "npm --prefix client run dev -- --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.12.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
